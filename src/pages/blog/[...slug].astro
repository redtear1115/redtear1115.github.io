---
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { allPosts, related as relatedPosts, excerpt } from '../../lib/posts';

function estimateReadingTime(text: string): number {
  const cjk = (text.match(/[　-鿿가-힯豈-﫿]/g) ?? []).length;
  const words = (text.match(/[a-zA-Z]+/g) ?? []).length;
  return Math.max(1, Math.ceil((cjk + words) / 300));
}

export async function getStaticPaths() {
  const posts = await allPosts();

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: posts[index + 1]
        ? { slug: posts[index + 1].slug, title: posts[index + 1].data.title }
        : undefined,
      next: posts[index - 1]
        ? { slug: posts[index - 1].slug, title: posts[index - 1].data.title }
        : undefined,
      related: relatedPosts(post, posts).map((p) => ({ slug: p.slug, title: p.data.title, date: p.data.pubDate.toISOString().slice(0, 10) })),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
  related: { slug: string; title: string; date: string }[];
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await post.render();
const { title, pubDate, tags, description, image, lang } = post.data;
const readingTime = estimateReadingTime(post.body);
const resolvedDescription = description ?? excerpt(post.body, 160, 157); // same cut as before the redesign (meta description)
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
---
<PostLayout title={title} pubDate={pubDate} tags={tags} prev={prev} next={next} related={related} toc={toc} readingTime={readingTime} description={resolvedDescription} image={image} lang={lang}>
  <Content />
</PostLayout>
