---
import '../styles/global.css';
// Self-hosted, latin-only subsets (CJK falls back to the system CJK face).
// ?url gives the same hashed asset the @font-face in global.css points at,
// so the preload is reused instead of fetched twice. Only the display serif is
// preloaded, and only on pages whose heading uses it: article text is mostly CJK,
// so preloading Inter would just spend bytes on the critical path.
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  preloadSerif?: boolean;
}

const { title, description = 'Notes on systems, tools, and side projects.', image, preloadSerif = false } = Astro.props;
const ogImage = new URL(image ?? '/og-image.png', Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#050a16" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Southern Light" href="/rss.xml" />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{preloadSerif && <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />}

<!-- Google Analytics 4 -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YHXFBMRQ3S"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-YHXFBMRQ3S');
</script>
