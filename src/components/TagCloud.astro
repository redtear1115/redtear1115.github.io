---
import { allPosts } from '../lib/posts';

interface Props {
  /** Cap the cloud (home page keeps it short; /blog and tag pages show every tag). */
  limit?: number;
}

const { limit } = Astro.props;
const posts = await allPosts();

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

function sizeClass(count: number): string {
  if (count >= 20) return 'size-xl';
  if (count >= 8) return 'size-lg';
  if (count >= 3) return 'size-md';
  return 'size-sm';
}

const all = [...counts.entries()].sort((a, b) => b[1] - a[1]);
const tags = limit ? all.slice(0, limit) : all;
const hidden = all.length - tags.length;
---

<aside class="page-sidebar" aria-label="標籤">
  <div class="sidebar-panel">
    <div class="sidebar-title">// tags</div>
    <div class="tag-cloud">
      {tags.map(([tag, count]) => (
        <a class={`tag-chip ${sizeClass(count)}`} href={`/tags/${tag}`}>
          {tag}
        </a>
      ))}
    </div>
    {hidden > 0 && <a class="tag-all" href="/blog">全部 {all.length} 個標籤 <span aria-hidden="true">→</span></a>}
  </div>
</aside>
