---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, tags } = post.data;
const dateStr = pubDate.toISOString().slice(0, 10);
---
<li class="post-card">
  <h2><a href={`/blog/${post.slug}`}>{title}</a></h2>
  <div class="meta">
    <time datetime={dateStr}>{dateStr}</time>
    {tags.slice(0, 5).map((tag) => <a class="tag" href={`/tags/${tag}`}>#{tag}</a>)}{tags.length > 5 && <span class="tag-more">...</span>}
  </div>
</li>
