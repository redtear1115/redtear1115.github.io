---
import type { CollectionEntry } from 'astro:content';
import Phrased from './Phrased.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Show the full date (home) instead of MM-DD (month-grouped archive). */
  fullDate?: boolean;
}

const { post, fullDate = false } = Astro.props;
const { title, pubDate, tags } = post.data;
const dateStr = pubDate.toISOString().slice(0, 10);
const shown = fullDate ? dateStr : dateStr.slice(5);
---
<li class="post-card" data-full={fullDate ? '' : undefined}>
  <time class="post-date" datetime={dateStr}>{shown}</time>
  <div class="post-body">
    <h2><a href={`/blog/${post.slug}`}><Phrased text={title} /></a></h2>
    <div class="meta">
      {tags.slice(0, 4).map((tag) => <a class="tag" href={`/tags/${tag}`}>#{tag}</a>)}{tags.length > 4 && <span class="tag-more" aria-label={`還有 ${tags.length - 4} 個標籤`}>…</span>}
    </div>
  </div>
</li>
