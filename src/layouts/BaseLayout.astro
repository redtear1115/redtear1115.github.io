---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TagCloud from '../components/TagCloud.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const { title, description, image, lang = 'zh-TW' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <slot name="head" />
    <script>
      // Sync aurora animations to wall-clock time so page navigation doesn't restart them.
      // Negative animation-delay jumps each animation to where it "should" be right now.
      (function () {
        const t = Date.now();
        const s = document.documentElement.style;
        s.setProperty('--phase-aurora-green',  `-${(t % 8000)  / 1000}s`);
        s.setProperty('--phase-aurora-purple', `-${(t % 13000) / 1000}s`);
        s.setProperty('--phase-ice',           `-${(t % 6000)  / 1000}s`);
      })();
    </script>
  </head>
  <body>
    <!-- Aurora bands (fixed, behind content) -->
    <div class="aurora-wrap" aria-hidden="true">
      <div class="aurora-band aurora-green"></div>
      <div class="aurora-band aurora-purple"></div>
    </div>

    <Header />
    <div class="site-wrapper">
      <div class="page-layout">
        <main class="page-main">
          <slot />
        </main>
        <TagCloud />
      </div>
    </div>
    <Footer />

    <script is:inline src="https://storage.ko-fi.com/cdn/scripts/overlay-widget.js"></script>
    <script is:inline>
      kofiWidgetOverlay.draw('ray19841115', {
        type: 'floating-chat',
        'floating-chat.donateButton.text': '請我喝杯咖啡',
        'floating-chat.donateButton.background-color': '#5ba3d9',
        'floating-chat.donateButton.text-color': '#0a0e1a'
      });

      // Source attribution: fire GA event on widget click, plus best-effort UTM
      // injection into Ko-fi's hidden iframe so their GA picks up the source too.
      (function () {
        const SOURCE = 'southern-light';
        const UTM = '&utm_source=' + SOURCE + '&utm_medium=kofi_widget';

        document.addEventListener('click', function (e) {
          if (e.target.closest('[class*="kofi"], [id*="kofi"]') && typeof gtag === 'function') {
            gtag('event', 'kofi_widget_click', { source: SOURCE });
          }
        });

        const patch = function () {
          document.querySelectorAll('iframe[src*="ko-fi.com"]').forEach(function (iframe) {
            if (!iframe.src.includes('utm_source')) {
              iframe.src = iframe.src + UTM;
            }
          });
        };
        new MutationObserver(patch).observe(document.body, { childList: true, subtree: true });
        patch();
      })();
    </script>
  </body>
</html>
