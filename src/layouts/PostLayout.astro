---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  pubDate: Date;
  tags: string[];
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
  readingTime?: number;
}

const { title, description, image, lang, pubDate, tags, prev, next, readingTime } = Astro.props;
const dateStr = pubDate.toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: pubDate.toISOString(),
  ...(description && { description }),
  ...(image && { image: new URL(image, Astro.site).toString() }),
  keywords: tags.join(', '),
  url: Astro.url.toString(),
  author: {
    '@type': 'Person',
    name: 'Ray Lee',
    url: Astro.site?.toString(),
  },
  publisher: {
    '@type': 'Person',
    name: 'Ray Lee',
    url: Astro.site?.toString(),
  },
};
---
<BaseLayout title={`${title} — Southern Light`} description={description} image={image} lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={dateStr}>{dateStr}</time>
        {readingTime && <span>~{readingTime} min</span>}
        {tags.map((tag) => <a class="tag-chip size-lg" href={`/tags/${tag}`}>#{tag}</a>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  {(prev || next) && (
    <nav class="post-nav">
      <div class="post-nav-prev">
        {prev && <a href={`/blog/${prev.slug}`}>← {prev.title}</a>}
      </div>
      <div class="post-nav-next">
        {next && <a href={`/blog/${next.slug}`}>{next.title} →</a>}
      </div>
    </nav>
  )}
</BaseLayout>
